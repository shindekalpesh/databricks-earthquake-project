{
  "datasets": [
    {
      "name": "e2c565b2",
      "displayName": "earthquake_detail",
      "queryLines": [
        "SELECT * FROM earthquake_data_streaming_tbl_final;"
      ],
      "catalog": "earthquake_dev_catalog",
      "schema": "silver"
    },
    {
      "name": "edbc6f51",
      "displayName": "magnitude_bucket",
      "queryLines": [
        "SELECT \r\n",
        "    COUNT(*) AS total_magnitude_bucket,\r\n",
        "    magnitude_bucket FROM (\r\n",
        "        SELECT \r\n",
        "            CASE\r\n",
        "                WHEN mag < 2 THEN 'Micro (<2)'\r\n",
        "                WHEN mag >= 2 AND mag < 3 THEN 'Minor (2-3)'\r\n",
        "                WHEN mag >= 3 AND mag < 4 THEN 'Light (3-4)'\r\n",
        "                ELSE 'Moderate (>=4)'\r\n",
        "    END AS magnitude_bucket\r\n",
        "        FROM earthquake_data_streaming_tbl_final)\r\n",
        "        GROUP BY magnitude_bucket"
      ],
      "catalog": "earthquake_dev_catalog",
      "schema": "silver"
    },
    {
      "name": "7e21fcf6",
      "displayName": "country_wise_bucket",
      "queryLines": [
        "SELECT \r\n",
        "    COUNT(*) AS event_count,\r\n",
        "    -- SPLIT(place, ', ')[1] AS country\r\n",
        "    CASE\r\n",
        "        WHEN SIZE(SPLIT(place, ', ')) = 1 THEN SPLIT(place, ', ')[0]\r\n",
        "        ELSE SPLIT(place, ', ')[1]\r\n",
        "    END AS country\r\n",
        "FROM earthquake_data_streaming_tbl_final\r\n",
        "GROUP BY country\r\n",
        "ORDER BY event_count DESC;"
      ],
      "catalog": "earthquake_dev_catalog",
      "schema": "silver"
    }
  ],
